{
  "name": "@qa-hub/playwright-tests",
  "version": "1.0.0",
  "description": "Enterprise Agnostic Playwright Automation Suite",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:project": "node scripts/run-project.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
