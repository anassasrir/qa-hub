{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectConfig",
  "description": "Configuration schema for an isolated project/client within QA-Hub",
  "type": "object",
  "required": [
    "id",
    "name",
    "branding",
    "issueTracker",
    "git",
    "ci",
    "environments",
    "playwright"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier for the project in kebab-case (e.g. 'acme-shop')"
    },
    "name": {
      "type": "string",
      "description": "Full display name of the client or project"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the application under test"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this project is active in the test runner and dashboard"
    },
    "branding": {
      "type": "object",
      "required": ["displayName", "primaryColor"],
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Name shown in the QA Dashboard header"
        },
        "logoUrl": {
          "type": "string",
          "description": "Path or URL to the client logo (SVG/PNG)"
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Hex primary brand color (e.g. '#0284c7')"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Optional hex accent color"
        }
      }
    },
    "issueTracker": {
      "type": "object",
      "required": ["type", "baseUrl", "ticketRegex"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["jira", "linear", "github", "gitlab", "azure-boards", "none"]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Base URL to view tickets (e.g. 'https://acme.atlassian.net/browse/')"
        },
        "ticketRegex": {
          "type": "string",
          "description": "Regex pattern matching ticket keys (e.g. 'ACM-[0-9]+')"
        },
        "exampleTicket": {
          "type": "string",
          "description": "Sample ticket key for validation and documentation (e.g. 'ACM-101')"
        }
      }
    },
    "git": {
      "type": "object",
      "required": ["scopes"],
      "properties": {
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed conventional commit scopes for this project"
        },
        "branchPattern": {
          "type": "string",
          "description": "Regex pattern enforced on branch names (e.g. '^(feat|fix|test)/ACM-[0-9]+-[a-z0-9-]+$')"
        }
      }
    },
    "ci": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "azure-pipelines", "bitbucket-pipelines", "local"]
        },
        "pipelineUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the CI dashboard/repository"
        }
      }
    },
    "environments": {
      "type": "object",
      "required": ["default", "targets"],
      "properties": {
        "default": {
          "type": "string",
          "description": "Default environment name to target if none is specified (e.g. 'staging')"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["baseUrl"],
            "properties": {
              "baseUrl": { "type": "string", "format": "uri" },
              "apiBaseUrl": { "type": "string" },
              "extra": { "type": "object" }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["env", "infisical", "vault", "doppler"],
          "default": "env"
        },
        "prefix": {
          "type": "string",
          "description": "Prefix used for environment variables (e.g. 'ACME_QA_')"
        }
      }
    },
    "playwright": {
      "type": "object",
      "required": ["testDir", "pageObjectsDir"],
      "properties": {
        "testDir": {
          "type": "string",
          "description": "Path relative to packages/playwright-tests/ (e.g. 'tests/acme-shop')"
        },
        "pageObjectsDir": {
          "type": "string",
          "description": "Path relative to packages/playwright-tests/ (e.g. 'pages/acme-shop')"
        },
        "fixturesDir": {
          "type": "string",
          "description": "Path relative to packages/playwright-tests/ (e.g. 'fixtures/acme-shop')"
        },
        "defaultTimeout": {
          "type": "number",
          "default": 30000
        },
        "retries": {
          "type": "object",
          "properties": {
            "ci": { "type": "number", "default": 2 },
            "local": { "type": "number", "default": 0 }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "description": "Configuration for code quality, security scans and Sonar integration",
      "properties": {
        "sonar": {
          "type": "object",
          "properties": {
            "hostUrl": { "type": "string", "format": "uri", "default": "https://sonarcloud.io" },
            "organization": { "type": "string", "description": "SonarCloud organization or SonarQube instance key" },
            "projectKey": { "type": "string", "description": "Global project key on Sonar" }
          }
        },
        "repositories": {
          "type": "array",
          "description": "List of source code repositories monitored for quality and security",
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "Unique identifier for the repository/component (e.g. 'qa-dashboard', 'api-backend')"
              },
              "name": {
                "type": "string",
                "description": "Display name of the component"
              },
              "type": {
                "type": "string",
                "enum": ["frontend", "backend", "fullstack", "mobile", "qa", "other"],
                "default": "frontend"
              },
              "repoUrl": {
                "type": "string",
                "description": "Git repository URL (e.g. 'https://github.com/org/repo.git')"
              },
              "branch": {
                "type": "string",
                "default": "main",
                "description": "Default branch monitored for quality"
              },
              "sonarKey": {
                "type": "string",
                "description": "Specific Sonar project key for this component"
              },
              "ci": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": ["github-actions", "gitlab-ci", "azure-pipelines", "bitbucket-pipelines", "local"]
                  },
                  "pipelineUrl": { "type": "string", "format": "uri" },
                  "jobName": {
                    "type": "string",
                    "description": "CI job name producing quality and test reports (e.g. 'quality-check', 'lint-test')"
                  },
                  "artifactPath": { "type": "string", "description": "Path to the uploaded coverage/linter report" }
                }
              }
            }
          }
        }
      }
    }
  }
}
